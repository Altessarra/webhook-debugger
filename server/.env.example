# Runtime data location. Docker Compose sets this to /app/data.
DATA_DIR=./data

# CORS and transport security.
CORS_ORIGIN=http://localhost:5173
ENABLE_HSTS=false

# Fixed-window rate limit duration: 1,000–3,600,000 ms; default 60,000.
RATE_LIMIT_WINDOW_MS=60000
# Requests per fixed window per relevant IP or inbox key.
# Defaults/bounds: inbox 10, webhook 120, history 30, manual send 10, replay 10;
# each request limit accepts 1–9,007,199,254,740,991.
RATE_LIMIT_INBOX_CREATION=10
RATE_LIMIT_WEBHOOK_INGESTION=120
RATE_LIMIT_HISTORY_READS=30
RATE_LIMIT_MANUAL_SEND=10
RATE_LIMIT_REPLAY=10
# In-memory limiter keys: 100–100,000; default 10,000.
MAX_RATE_LIMIT_KEYS=10000

# History and retention.
# History page size: 1–100; default 50. The hard cap is 100.
HISTORY_DEFAULT_PAGE_SIZE=50
# Requests retained per inbox: 1–100,000; default 1,000.
MAX_REQUESTS_PER_INBOX=1000
# Request retention: 1–8,760 hours; default 168.
REQUEST_RETENTION_HOURS=168
# Retention cleanup interval: 60,000–86,400,000 ms; default 900,000.
RETENTION_CLEANUP_INTERVAL_MS=900000

# WebSocket lifecycle and payload limits.
# WebSocket connections per IP: 1–100; default 10.
WS_MAX_CONNECTIONS_PER_IP=10
# WebSocket heartbeat interval: 5,000–300,000 ms; default 30,000.
WS_HEARTBEAT_INTERVAL_MS=30000
# WebSocket idle timeout: 15,000–900,000 ms; default 90,000; must exceed heartbeat.
WS_IDLE_TIMEOUT_MS=90000
# WebSocket payload size: 1,024–1,048,576 bytes; default 65,536.
WS_MAX_PAYLOAD_BYTES=65536

# Outbound manual-send and replay safeguards.
# Outbound timeout: 1,000–120,000 ms; default 15,000.
OUTBOUND_TIMEOUT_MS=15000
# Outbound response cap: 65,536–16,777,216 bytes; default 2,097,152.
OUTBOUND_MAX_RESPONSE_BYTES=2097152
# Concurrent outbound operations: 1–32; default 4.
OUTBOUND_MAX_CONCURRENCY=4
